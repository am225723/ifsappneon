# Server-only values (set real values in local/Vercel environments, never in git)
DATABASE_URL=
CLERK_SECRET_KEY=
OPENROUTER_API_KEY=

# Public Clerk publishable key for Vite frontend
VITE_CLERK_PUBLISHABLE_KEY=

# Phase 18C QA admin seed placeholders only.
# Create the password in Clerk or an approved password manager; do not store it here.
# QA_ADMIN_PASSWORD is intentionally omitted; the seed script aborts if it is set.
QA_ADMIN_EMAIL=
QA_ADMIN_NAME=QA Admin
QA_ADMIN_CLERK_USER_ID=
QA_ADMIN_ROLE=admin
QA_DEMO_CLIENT_EMAIL=
QA_DEMO_CLIENT_NAME=Demo Client
ENABLE_QA_SEED=false
